(*
  A symbolic model of isudo's two protocols, for ProVerif.

    ./formal/check.sh

  What is modelled
  ----------------
  Pairing: the host shows a QR code (its public key and a one-time secret);
  the phone answers with its public key and a MAC under the secret; the host
  acknowledges the answer it accepted with a signature over that key and a
  fresh nonce; the phone, having verified that acknowledgement over its own
  key, shows a short code derived from the nonce; the person types the code
  into the host; the host pins the phone's key and signs a confirmation.

  Approval: the host signs a request (a fresh nonce and the command); the
  phone, having verified the host's signature, shows it; the person approves
  or denies; the phone signs the answer; the host acts only on a signature
  by the pinned key over this request.

  The attacker
  ------------
  Controls the network and the relay (everything is sent on the public
  channel), chooses every command (the caller is hostile), and SEES EVERY QR
  CODE, so the pairing secret is public knowledge in this model. The host's
  private key is handed to the attacker once pairing has finished.

  The short code
  --------------
  Six digits can be matched by trial: an attacker who knows the secret can
  find keys of its own whose code equals any target. The model gives the
  attacker that power outright by making the code independent of every key:
  it depends only on the pairing, the secret and the host's nonce. So
  whatever the properties below owe to the code, they owe to two things
  only: the person has a code to type only if their own phone showed one,
  and the code is tied to a nonce the host chose for one acknowledgement.

  The earlier design
  ------------------
  pairing-v0.pv is the first design, in which the phone showed a code as
  soon as it had scanned. check.sh runs it too and expects its property to
  FAIL: that is the attack the acknowledgement was added to stop.

  Not modelled: confidentiality of requests (the HPKE envelope), the phone's
  second key, clocks and expiry, and everything about what a command does.
*)

free c: channel.              (* network and relay: the attacker's *)
free qr: channel [private].   (* what the host's screen shows *)
free human: channel [private].(* the person reading their phone and typing *)

type skey.
type pkey.

fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), pk(k)) = m.
reduc forall m: bitstring, k: skey; getmessage(sign(m, k)) = m.

fun mac(bitstring, bitstring): bitstring.
fun h(bitstring): bitstring.
fun shortcode(bitstring, bitstring, bitstring): bitstring.   (* (pairing, secret, nonce): binds no key *)

(* Distinct context tags, as in crates/proto/src/sigs.rs. *)
const tagAck, tagConfirm, tagRequest, tagApprove, tagDeny: bitstring.

event PhoneScanned(bitstring, pkey).       (* the person's phone made this key for this pairing *)
event HostAccepted(bitstring, pkey).
event CodeShown(bitstring, pkey).
event Pinned(bitstring, pkey).             (* the host wrote this key into its pairing file *)
event PhoneActive(bitstring, pkey).
event HostKeyLeaked(bitstring).

event Asked(bitstring, bitstring, bitstring).            (* pairing, nonce, command *)
event Shown(bitstring, bitstring, bitstring).
event Approved(bitstring, bitstring, bitstring).
event Denied(bitstring, bitstring, bitstring, bitstring).(* ..., reason *)
event Exec(bitstring, bitstring, bitstring).
event DenialShown(bitstring, bitstring, bitstring, bitstring).

(* ---- Pairing ---------------------------------------------------------- *)

(* 1. The host pins a key only if the person's own phone made it. *)
query p: bitstring, k: pkey; event(Pinned(p, k)) ==> event(PhoneScanned(p, k)).

(* 2. A phone has a code to show only if the host accepted that phone's key.
      (Once pairing is over and the host's key has leaked, a phone scanning a
      stale QR code can be shown anything; nothing is listening by then.) *)
query p: bitstring, k: pkey; event(CodeShown(p, k)) ==> event(HostAccepted(p, k)) || event(HostKeyLeaked(p)).

(* 3. A phone considers itself paired only if the host pinned its key. *)
query p: bitstring, k: pkey; event(PhoneActive(p, k)) ==> event(Pinned(p, k)) || event(HostKeyLeaked(p)).

(* ---- Approval --------------------------------------------------------- *)

(* 4. A command runs only if the phone approved exactly that request. *)
query p: bitstring, n: bitstring, m: bitstring; event(Exec(p, n, m)) ==> event(Approved(p, n, m)).

(* 5. Each run corresponds to its own, distinct ask: no replay, no reuse. *)
query p: bitstring, n: bitstring, m: bitstring; inj-event(Exec(p, n, m)) ==> inj-event(Asked(p, n, m)).

(* 6. The phone shows only requests the host made (unless the host's key leaked). *)
query p: bitstring, n: bitstring, m: bitstring;
  event(Shown(p, n, m)) ==> event(Asked(p, n, m)) || event(HostKeyLeaked(p)).

(* 7. A denial reason reaches the caller only as the phone signed it. *)
query p: bitstring, n: bitstring, m: bitstring, r: bitstring;
  event(DenialShown(p, n, m, r)) ==> event(Denied(p, n, m, r)).

(* ---- Sanity: the protocol can actually complete ------------------------ *)
(* These are expected to be reported FALSE, meaning the event is reachable. *)
query p: bitstring, n: bitstring, m: bitstring; event(Exec(p, n, m)).
query p: bitstring, n: bitstring, m: bitstring, r: bitstring; event(DenialShown(p, n, m, r)).

(* One `isudo command` invocation, after pairing. *)
let HostAsk(pid: bitstring, skH: skey, pkP: pkey) =
  in(c, cmd: bitstring);                       (* the caller chooses the command *)
  new n: bitstring;                            (* the nonce lives only in this process *)
  event Asked(pid, n, cmd);
  out(c, ((pid, n, cmd), sign((tagRequest, pid, n, cmd), skH)));
  in(c, answer: bitstring) [precise];          (* whatever the helper hands back, once *)
  let (=tagApprove, =h((pid, n, cmd))) = checksign(answer, pkP) in
    event Exec(pid, n, cmd)
  else
    let (reason: bitstring, sig: bitstring) = answer in
    let (=tagDeny, =h((pid, n, cmd)), =reason) = checksign(sig, pkP) in
    event DenialShown(pid, n, cmd, reason).

(* `isudo-admin pair`, then any number of invocations. *)
let Host() =
  new skH: skey;
  new qrsecret: bitstring;
  new pid: bitstring;
  let pkH = pk(skH) in
  out(c, (pid, pkH));
  ( !out(qr, (pid, pkH, qrsecret)) )
  | (
    in(c, (=pid, pkP: pkey, m: bitstring)) [precise];   (* one answer per offer *)
    if m = mac((pid, pkH, pkP), qrsecret) then
    event HostAccepted(pid, pkP);
    new ackNonce: bitstring;                     (* chosen after the key arrived *)
    out(c, (ackNonce, sign((tagAck, pid, pkP, ackNonce), skH)));
    in(human, (=pid, typed: bitstring)) [precise];
    if typed = shortcode(pid, qrsecret, ackNonce) then
    event Pinned(pid, pkP);
    out(c, sign((tagConfirm, pid, pkP), skH));
    ( !HostAsk(pid, skH, pkP) )
    | ( event HostKeyLeaked(pid); out(c, skH) )
  ).

(* The phone looking at one delivered request. *)
let PhoneAnswer(pid: bitstring, pkH: pkey, skP: skey) =
  in(c, ((=pid, n: bitstring, cmd: bitstring), sig: bitstring));
  let (=tagRequest, =pid, =n, =cmd) = checksign(sig, pkH) in
  event Shown(pid, n, cmd);
  in(c, approves: bool);                       (* the person may do either *)
  if approves then (
    event Approved(pid, n, cmd);
    out(c, sign((tagApprove, h((pid, n, cmd))), skP))
  ) else (
    new reason: bitstring;
    event Denied(pid, n, cmd, reason);
    out(c, (reason, sign((tagDeny, h((pid, n, cmd)), reason), skP)))
  ).

(* The person's phone: scans, pairs, then answers requests. *)
let Phone() =
  in(qr, (pid: bitstring, pkH: pkey, qrsecret: bitstring));
  new skP: skey;
  let pkP = pk(skP) in
  event PhoneScanned(pid, pkP);
  out(c, (pid, pkP, mac((pid, pkH, pkP), qrsecret)));
  in(c, (ackNonce: bitstring, ack: bitstring));
  let (=tagAck, =pid, =pkP, =ackNonce) = checksign(ack, pkH) in
  event CodeShown(pid, pkP);
  out(human, (pid, shortcode(pid, qrsecret, ackNonce)));
  in(c, confirmation: bitstring);
  let (=tagConfirm, =pid, =pkP) = checksign(confirmation, pkH) in
  event PhoneActive(pid, pkP);
  !PhoneAnswer(pid, pkH, skP).

process
    ( !Host() )
  | ( !Phone() )
  | ( !in(qr, seen: bitstring); out(c, seen) )   (* an onlooker reads every QR code *)
